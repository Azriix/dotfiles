# Downloaded by chezmoi, not stored here. Refresh: chezmoi apply --refresh-externals

{{- range list "zsh-autosuggestions" "zsh-syntax-highlighting" }}

[".config/zsh/plugins/{{ . }}"]
  type = "git-repo"
  url = "https://github.com/zsh-users/{{ . }}.git"
  refreshPeriod = "168h"
  [".config/zsh/plugins/{{ . }}".clone]
    args = ["--depth", "1"]
  [".config/zsh/plugins/{{ . }}".pull]
    args = ["--ff-only"]
{{- end }}

{{- if eq .chezmoi.os "linux" }}

# On macOS the font comes from Homebrew
[".local/share/fonts/JetBrainsMonoNerd"]
  type = "archive"
  url = "https://github.com/ryanoasis/nerd-fonts/releases/latest/download/JetBrainsMono.tar.xz"
  exact = true
  refreshPeriod = "720h"
  include = ["*.ttf"]
{{- end }}

# Typora theme "Github Dark" (MIT). CSS files only: the Open Sans fonts it uses are
# already in Typora's built-in themes/github/ folder.
{{- $typoraThemes := ".config/Typora/themes" }}
{{- if eq .chezmoi.os "darwin" }}
{{-   $typoraThemes = "Library/Application Support/abnerworks.Typora/themes" }}
{{- end }}
{{- range list "github-dark.css" "github/base.css" }}

[{{ printf "%s/%s" $typoraThemes . | quote }}]
  type = "archive-file"
  url = "https://github.com/SprInec/typora-theme-github-dark/archive/refs/heads/main.tar.gz"
  path = {{ printf "typora-theme-github-dark-main/%s" . | quote }}
  refreshPeriod = "720h"
{{- end }}
