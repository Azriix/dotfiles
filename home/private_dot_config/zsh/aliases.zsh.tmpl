# Generated by chezmoi ({{ .chezmoi.os }}). Edit: cze $ZDOTDIR/aliases.zsh

# --- System update ------------------------------------------------------------
_update() {
{{- if eq .chezmoi.os "darwin" }}
    echo ":: brew"
    brew update && brew upgrade && brew cleanup
{{- else }}
    echo ":: apt"
    sudo apt-get -qq update
    sudo DEBIAN_FRONTEND=noninteractive apt-get -y -qq upgrade
    sudo apt-get -y -qq autoremove
    sudo apt-get -qq clean

    if command -v flatpak >/dev/null; then
        echo ":: flatpak"
        flatpak update -y --noninteractive
        flatpak uninstall --unused -y --noninteractive
    fi

    if command -v snap >/dev/null; then
        echo ":: snap"
        sudo snap refresh
    fi
{{- end }}

    if command -v uv >/dev/null; then
        echo ":: uv"
        uv tool upgrade --all
    fi

    echo ":: dotfiles"
    chezmoi update --refresh-externals

    echo ":: ok"
}
alias update=_update

alias c='codium .'
alias p='python3'
alias t='tmux'

# --- chezmoi ------------------------------------------------------------------
alias cz='chezmoi'
alias cze='chezmoi edit --apply'
alias czd='chezmoi diff'
alias czcd='chezmoi cd'

# --- Modern ls / cat / df (if installed) --------------------------------------
if command -v eza >/dev/null; then
    alias ls='eza --group-directories-first'
    alias ll='eza --group-directories-first -l'
    alias la='eza -lagh'
    alias lt='eza -a --tree --level=2'
    alias ltf='eza -a --tree'
    alias lat='eza -lagh --tree'
fi

{{ if eq .chezmoi.os "linux" -}}
# bat is called batcat on Ubuntu
command -v batcat >/dev/null && ! command -v bat >/dev/null && alias bat='batcat'
{{ end -}}
if (( $+aliases[bat] || $+commands[bat] )); then
    alias cat='bat --style=header --pager "less -RF"'
    alias catn='bat --pager "less -RF"'
fi

command -v duf >/dev/null && alias df='duf'

alias grep='grep --color=auto'
alias cgrep='grep --color=always'

# --- Sysadmin -----------------------------------------------------------------
{{- if eq .chezmoi.os "linux" }}
alias ipa='ip -br a | grep -vF DOWN | cut -d/ -f1'
{{- end }}
alias get-ip='curl -sS ipinfo.io'

# --- Encoding -----------------------------------------------------------------
alias b64d='base64 -d'
{{- if eq .chezmoi.os "darwin" }}
alias b64e='base64'
{{- else }}
alias b64e='base64 -w 0'
{{- end }}
