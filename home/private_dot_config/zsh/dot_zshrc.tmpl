# Generated by chezmoi ({{ .chezmoi.os }}). Edit: cze $ZDOTDIR/.zshrc
{{- if eq .chezmoi.os "darwin" }}

# --- Homebrew -----------------------------------------------------------------
if [[ -x /opt/homebrew/bin/brew ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
fi
{{- end }}

# --- PATH ---------------------------------------------------------------------
typeset -U path
path=("$HOME/.local/bin" $path)

# --- History ------------------------------------------------------------------
HISTFILE="$XDG_STATE_HOME/zsh/history"
HISTSIZE=50000
SAVEHIST=50000
setopt extended_history share_history hist_ignore_all_dups hist_ignore_space hist_reduce_blanks

# --- Options ------------------------------------------------------------------
setopt auto_cd interactive_comments no_beep
bindkey -e
bindkey '^[[A' history-search-backward
bindkey '^[[B' history-search-forward
bindkey '^[[1;5D' backward-word      # Ctrl+Left
bindkey '^[[1;5C' forward-word       # Ctrl+Right
bindkey '^[[1;3D' backward-word      # Alt+Left
bindkey '^[[1;3C' forward-word       # Alt+Right
bindkey '^[[H'    beginning-of-line  # Home
bindkey '^[[F'    end-of-line        # End
bindkey '^[[3;5~' kill-word          # Ctrl+Delete
bindkey '^[[Z'    reverse-menu-complete  # Shift+Tab

# --- Completion ---------------------------------------------------------------
# Rebuild the dump once a day (picks up new completions), otherwise load it as is
autoload -Uz compinit
_zcomp="$XDG_CACHE_HOME/zsh/zcompdump"
_stale=( $_zcomp(N.mh+24) )
if [[ ! -f $_zcomp || -n $_stale ]]; then
    compinit -d "$_zcomp"
else
    compinit -C -d "$_zcomp"
fi
unset _zcomp _stale
zstyle ':completion:*' menu select
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
setopt complete_in_word always_to_end
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'

# --- SSH agent ----------------------------------------------------------------
{{- if eq .chezmoi.os "darwin" }}
# Secretive: Secure Enclave key, Touch ID
_sock="$HOME/Library/Containers/com.maxgoedjen.Secretive.SecretAgent/Data/socket.ssh"
{{- else }}
# GNOME agent (gcr), keys loaded by KeePassXC
_sock="$XDG_RUNTIME_DIR/gcr/ssh"
{{- end }}
[[ -S "$_sock" ]] && export SSH_AUTH_SOCK="$_sock"
unset _sock

{{- if eq .chezmoi.os "linux" }}

# --- libvirt ------------------------------------------------------------------
export LIBVIRT_DEFAULT_URI="qemu:///system"
{{- end }}

# --- Aliases ------------------------------------------------------------------
source "$ZDOTDIR/aliases.zsh"
[[ -f "$ZDOTDIR/local.zsh" ]] && source "$ZDOTDIR/local.zsh"   # per-machine, not versioned

# --- Plugins ------------------------------------------------------------------
source "$ZDOTDIR/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh"
source "$ZDOTDIR/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"   # must be last

# --- Prompt -------------------------------------------------------------------
eval "$(starship init zsh)"
