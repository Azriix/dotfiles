# Generated by chezmoi. Edit: chezmoi edit --apply ~/.ssh/config
# No private keys here: one key per machine.

# Per-machine hosts (not versioned)
Include config.local

Host *
  AddKeysToAgent yes
{{- if eq .chezmoi.os "darwin" }}
  # Secretive: Secure Enclave + Touch ID
  IdentityAgent ~/Library/Containers/com.maxgoedjen.Secretive.SecretAgent/Data/socket.ssh
{{- end }}
