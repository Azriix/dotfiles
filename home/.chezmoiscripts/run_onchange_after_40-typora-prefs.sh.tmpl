{{ if or (eq .chezmoi.os "darwin") (eq .chezmoi.os "linux") -}}
#!/usr/bin/env bash
# Typora settings from .chezmoidata/typora.yaml. Only these keys are written, never
# the whole profile (it also holds window state and recent folders). Typora must be closed.
set -euo pipefail

if pgrep -x -i typora >/dev/null; then
    echo "Typora is running: settings not applied. Quit it, then change .chezmoidata/typora.yaml or run this script by hand." >&2
    exit 0
fi

{{ $prefs := merge (dict) .typora.prefs.common (get .typora.prefs .chezmoi.os) -}}
{{ if eq .chezmoi.os "darwin" -}}
{{   range $key, $value := $prefs -}}
{{     if kindIs "bool" $value -}}
defaults write abnerworks.Typora {{ $key | quote }} -bool {{ $value }}
{{     else if or (kindIs "int" $value) (kindIs "int64" $value) (kindIs "float64" $value) -}}
defaults write abnerworks.Typora {{ $key | quote }} -int {{ $value }}
{{     else -}}
defaults write abnerworks.Typora {{ $key | quote }} -string {{ $value | quote }}
{{     end -}}
{{   end -}}

{{ else -}}
# Linux: ~/.config/Typora/profile.data is hex-encoded JSON
profile="${XDG_CONFIG_HOME:-$HOME/.config}/Typora/profile.data"
mkdir -p "$(dirname "$profile")"

python3 -I - "$profile" {{ $prefs | toJson | squote }} <<'EOF'
import json, os, sys

path, prefs = sys.argv[1], json.loads(sys.argv[2])

data = {}
if os.path.exists(path):
    with open(path) as f:
        raw = f.read().strip()
    if raw:
        data = json.loads(bytes.fromhex(raw).decode("utf-8"))

data.update(prefs)

tmp = path + ".tmp"
with open(tmp, "w") as f:
    f.write(json.dumps(data, ensure_ascii=False, separators=(",", ":")).encode("utf-8").hex())
os.replace(tmp, path)
EOF
{{ end -}}
{{ end -}}
