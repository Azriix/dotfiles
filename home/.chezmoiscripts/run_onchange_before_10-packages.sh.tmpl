#!/usr/bin/env bash
# Install packages from .chezmoidata/packages.yaml (re-run when the list changes).
set -euo pipefail

{{ if eq .chezmoi.os "darwin" -}}
if ! command -v brew >/dev/null; then
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi
eval "$(/opt/homebrew/bin/brew shellenv)"

# --no-upgrade: upgrades are done by the `update` alias
brew bundle --no-upgrade --file=/dev/stdin <<EOF
{{ range .packages.darwin.brews -}}
brew {{ . | quote }}
{{ end -}}
{{ range .packages.darwin.casks -}}
cask {{ . | quote }}
{{ end -}}
EOF

{{ else if eq .chezmoi.os "linux" -}}
if ! command -v apt-get >/dev/null; then
    echo "apt-get not found: only Ubuntu-like distributions are supported." >&2
    exit 0
fi

wanted=({{ range .packages.linux.apt }}{{ . | quote }} {{ end }})
available=()
sudo apt-get update -qq
for pkg in "${wanted[@]}"; do
    if apt-cache show "$pkg" >/dev/null 2>&1; then
        available+=("$pkg")
    else
        echo "    ! $pkg not in the repositories, skipped" >&2
    fi
done
sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -qq "${available[@]}"

mkdir -p "$HOME/.local/bin"
export PATH="$HOME/.local/bin:$PATH"

{{ range .packages.linux.extra -}}
{{ if eq . "starship" -}}
command -v starship >/dev/null \
    || curl -sS https://starship.rs/install.sh | sh -s -- -y -b "$HOME/.local/bin"
{{ else if eq . "uv" -}}
command -v uv >/dev/null \
    || curl -LsSf https://astral.sh/uv/install.sh | sh
{{ else if eq . "ghostty" -}}
if ! command -v ghostty >/dev/null; then
    # apt on Ubuntu 26.04+, otherwise the ghostty-ubuntu .deb (no snap)
    if apt-cache show ghostty >/dev/null 2>&1; then
        sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -qq ghostty
    else
        /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/mkasberg/ghostty-ubuntu/HEAD/install.sh)"
    fi
fi
{{ end -}}
{{ end -}}
{{ end -}}
